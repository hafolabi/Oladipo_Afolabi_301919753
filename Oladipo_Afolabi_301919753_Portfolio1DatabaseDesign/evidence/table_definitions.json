    },
    {
      "relation": "accounts",
      "name": "accounts_kind_ck",
      "definition": "CHECK ((account_kind = ANY (ARRAY['customer'::text, 'system_clearing'::text])))"
    },
    {
      "relation": "accounts",
      "name": "accounts_number_format_ck",
      "definition": "CHECK ((account_number ~ '^[0-9]{10}$'::text))"
    },
    {
      "relation": "accounts",
      "name": "accounts_opened_at_not_null",
      "definition": "NOT NULL opened_at"
    },
    {
      "relation": "accounts",
      "name": "accounts_ownership_ck",
      "definition": "CHECK ((((account_kind = 'customer'::text) AND (customer_id IS NOT NULL)) OR ((account_kind = 'system_clearing'::text) AND (customer_id IS NULL))))"
    },
    {
      "relation": "accounts",
      "name": "accounts_pkey",
      "definition": "PRIMARY KEY (account_id)"
    },
    {
      "relation": "accounts",
      "name": "accounts_status_ck",
      "definition": "CHECK ((status = ANY (ARRAY['active'::text, 'frozen'::text, 'closed'::text])))"
    },
    {
      "relation": "accounts",
      "name": "accounts_status_not_null",
      "definition": "NOT NULL status"
    },
