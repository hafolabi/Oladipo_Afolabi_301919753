      "definition": "UNIQUE (account_number)"
    },
    {
      "relation": "accounts",
      "name": "accounts_account_number_not_null",
      "definition": "NOT NULL account_number"
    },
    {
      "relation": "accounts",
      "name": "accounts_currency_ck",
      "definition": "CHECK ((currency_code = 'NGN'::text))"
    },
    {
      "relation": "accounts",
      "name": "accounts_currency_code_not_null",
      "definition": "NOT NULL currency_code"
    },
    {
