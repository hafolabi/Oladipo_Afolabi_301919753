  "constraints": [
    {
      "relation": "accounts",
      "name": "accounts_account_id_not_null",
      "definition": "NOT NULL account_id"
    },
    {
      "relation": "accounts",
      "name": "accounts_account_kind_not_null",
      "definition": "NOT NULL account_kind"
    },
    {
      "relation": "accounts",
